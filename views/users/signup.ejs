<% layout("/layouts/boilerplate") %>
<div class="row mt-3">
    <div class="col-md-6 offset-md-3">

        <h2 class="mb-4">Sign Up</h2>

        <form method="POST" action="/signup" class="needs-validation" novalidate>

            <div class="mb-3">
                <label for="username" class="form-label">
                    Username
                </label>

                <input
                    type="text"
                    id="username"
                    name="username"
                    class="form-control"
                    required>
            </div>

            <div class="mb-3">
                <label for="email" class="form-label">
                    Email
                </label>

                <input
                    type="email"
                    id="email"
                    name="email"
                    class="form-control"
                    required>
            </div>

            <div class="mb-3">
                <label for="password" class="form-label">
                    Password
                </label>

                <input
                    type="password"
                    id="password"
                    name="password"
                    class="form-control"
                    required>
            </div>

            <button class="btn btn-dark mb-2">
                Sign Up
            </button>

        </form>

    </div>
</div>